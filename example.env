# dmarcd settings. Copy to .env and fill in. Everything is configured here;
# nothing about your mail provider is hard-coded.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The mailbox your DMARC record sends aggregate reports to
# (rua=mailto:THIS-ADDRESS in your _dmarc TXT record).
EMAIL=dmarc@example.org
PASSWORD=change-me

# Who gets the readable digest. Comma-separate several addresses.
FWD_REPORT_EMAIL=you@example.org

# Your provider's IMAP server (incoming mail).
IMAP_HOST=mail.example.org

# ---------------------------------------------------------------------------
# Incoming mail (IMAP)
# ---------------------------------------------------------------------------

# ssl (implicit TLS, usually port 993) or starttls (usually port 143).
IMAP_SECURITY=ssl
IMAP_PORT=993
# Login name if it isn't EMAIL.
#IMAP_USER=
# Folder to read reports from.
IMAP_FOLDER=INBOX
# What to do with a message once its reports are saved (they're kept in the
# local database, so the digest still attaches the originals):
#   keep    mark it read and leave it (default)
#   move    mark it read and move it to IMAP_ARCHIVE_FOLDER
#   delete  delete it permanently (expunged, not moved to Trash)
# Messages with no DMARC report in them (e.g. a person writing to the
# address) or with a report that can't be read are never moved or deleted:
# they stay unread in IMAP_FOLDER and the next digest mentions them.
PROCESSED_ACTION=keep
# Treat the mailbox as a no-reply, report-only inbox: permanently delete any
# message that contains no DMARC report (bounces, auto-replies, spam, people
# writing in). Messages with a report that can't be read are still kept so
# you can see why. The next digest lists what was deleted. 0 = off.
INBOX_CLEANUP=0
# Folder for PROCESSED_ACTION=move (created if missing). Many servers use "."
# as the separator, e.g. INBOX.processed; others use "/", e.g. Archive/DMARC.
IMAP_ARCHIVE_FOLDER=

# ---------------------------------------------------------------------------
# Outgoing mail (SMTP) for the digest
# ---------------------------------------------------------------------------

# Defaults to IMAP_HOST.
#SMTP_HOST=mail.example.org
# ssl (implicit TLS, usually 465), starttls (usually 587) or none (local
# testing only, e.g. a Mailpit/MailHog catcher on port 1025).
SMTP_SECURITY=ssl
SMTP_PORT=465
# Default to EMAIL / PASSWORD. Set SMTP_USER= (empty) to skip SMTP login.
#SMTP_USER=
#SMTP_PASSWORD=
# Sender of the digest. Defaults to EMAIL — keep it on your own domain so the
# digest itself passes DMARC.
#FROM_EMAIL=
FROM_NAME=DMARC Reports

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# How often to check the mailbox (seconds, minimum 60).
POLL_INTERVAL_SECONDS=900
# Empty: send a digest after every check that found new reports.
# HH:MM (24h, in TZ): collect reports and send one digest a day at that time.
DIGEST_TIME=
# Time zone for DIGEST_TIME and dates in the digest (IANA name).
TZ=UTC
# Look up reverse DNS for sending IPs (helps identify who sent the mail).
RDNS=1
# Attach the original report files / a CSV of every record to the digest.
ATTACH_ORIGINALS=1
ATTACH_CSV=1
LOG_LEVEL=INFO
# Where state (SQLite) lives. The container uses /data (a volume).
#DATA_DIR=/data
